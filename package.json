{
  "name": "justwork-doc-shell",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js build --watch",
    "backend": "uv run --directory backend --env-file .env -m uvicorn app.main:app --host 127.0.0.1 --port 1446",
    "dev:backend": "uv run --directory backend --env-file .env -m uvicorn app.main:app --host 127.0.0.1 --port 1446 --reload",
    "build": "node node_modules/vite/bin/vite.js build && node scripts/sanitize-chrome-store-dist.mjs",
    "build:packages": "yarn workspace @justwork/agent-protocol build && yarn workspace @justwork/security build && yarn workspace @justwork/workspace-runtime build && yarn workspace @justwork/bridge build && yarn workspace @justwork/cli build",
    "typecheck": "tsc --noEmit && yarn workspace @justwork/agent-protocol typecheck && yarn workspace @justwork/security typecheck && yarn workspace @justwork/workspace-runtime typecheck && yarn workspace @justwork/bridge typecheck && yarn workspace @justwork/cli typecheck",
    "test": "yarn build:packages && node scripts/run-node-tests.mjs",
    "test:e2e": "yarn build && node scripts/workbench-headless-e2e.mjs",
    "test:e2e:backend": "yarn build && node scripts/workbench-backend-e2e.mjs",
    "test:e2e:backend:offline": "yarn build && node scripts/workbench-backend-offline-e2e.mjs",
    "test:e2e:extension": "yarn build && node scripts/workbench-e2e.mjs",
    "test:backend": "python -m unittest backend.tests.test_backend_agent_api backend.tests.test_write_signing",
    "test:cli": "yarn build:packages && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cli-workspace-e2e.ps1",
    "justwork": "node packages/cli/dist/index.js",
    "package:chrome-store": "powershell -NoProfile -ExecutionPolicy Bypass -File .publish/package-extension.ps1"
  },
  "dependencies": {
    "@justwork/security": "0.0.1",
    "@justwork/workspace-runtime": "0.0.1",
    "@univerjs/preset-sheets-core": "^0.22.0",
    "@univerjs/presets": "^0.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rxjs": "^7.8.2",
    "sortablejs": "^1.15.7",
    "vditor": "^3.11.2",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.277",
    "@types/node": "^22.15.3",
    "playwright": "^1.59.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^3.1.1"
  }
}
