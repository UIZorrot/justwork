# Copy to `.env` in this directory (`backend/.env`) — loaded automatically by the app when python-dotenv is installed.
# Never commit `.env`. These variables are server-side only.

# Optional: require `Authorization: Bearer <token>` on all API routes.
# JUSTWORK_BACKEND_TOKEN=
# Shared by every backend worker/instance. Falls back to JUSTWORK_BACKEND_TOKEN.
# JUSTWORK_COLLAB_TICKET_SECRET=

# PostgreSQL; leave unset to use file-backed JSON (see JUSTWORK_BACKEND_DATA_FILE).
# JUSTWORK_DATABASE_URL=

# File path for local JSON store (default relative to cwd when starting uvicorn).
# JUSTWORK_BACKEND_DATA_FILE=
# Local JSON-backend fallback for Yjs room snapshots and room epochs. PostgreSQL
# deployments store these in collaborative_rooms/collaborative_updates instead.
# JUSTWORK_BACKEND_COLLAB_DIR=
# PostgreSQL Yjs snapshot compaction thresholds (incremental updates remain durable).
# JUSTWORK_COLLAB_COMPACT_UPDATE_COUNT=64
# JUSTWORK_COLLAB_COMPACT_UPDATE_BYTES=1048576

# Share links (readonly): signed token + optional public base URL.
# JUSTWORK_SHARE_SECRET=
# JUSTWORK_PUBLIC_BASE_URL=http://127.0.0.1:1446

# Stripe paid workspace Checkout. Price amount/currency live in Stripe, not source code.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PAID_WORKSPACE_PRICE_ID=
# STRIPE_PAID_WORKSPACE_CHECKOUT_MODE=payment
# JUSTWORK_PAID_WORKSPACE_PRICE_LABEL=
#
# Required before customers can route a paid workspace to their PostgreSQL database.
# Use a random secret of at least 32 characters and never rotate it without re-encrypting routes.
# JUSTWORK_DATABASE_ROUTING_SECRET=
#
# Optional global quota override for development only:
# JUSTWORK_QUOTA_PLAN=free
#
# Free plan defaults:
# JUSTWORK_QUOTA_WORKSPACE_MAX_BYTES_FREE=41943040
# JUSTWORK_QUOTA_PAGE_MAX_COUNT_FREE=300
# JUSTWORK_QUOTA_FOLDER_MAX_COUNT_FREE=100
# JUSTWORK_QUOTA_HISTORY_MAX_EVENTS_FREE=200
#
# Paid plan defaults (workspace bytes are always at least 4x the free value):
# JUSTWORK_QUOTA_WORKSPACE_MAX_BYTES_PAID=167772160
# JUSTWORK_QUOTA_PAGE_MAX_COUNT_PAID=1500
# JUSTWORK_QUOTA_FOLDER_MAX_COUNT_PAID=500
# JUSTWORK_QUOTA_HISTORY_MAX_EVENTS_PAID=1000
