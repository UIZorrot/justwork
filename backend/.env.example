# Copy to `.env` in this directory (`backend/.env`) — loaded automatically by the app when python-dotenv is installed.
# Never commit `.env`. These variables are server-side only.

# Optional: require `Authorization: Bearer <token>` on all API routes.
# JUSTWORK_BACKEND_TOKEN=

# PostgreSQL; leave unset to use file-backed JSON (see JUSTWORK_BACKEND_DATA_FILE).
# JUSTWORK_DATABASE_URL=

# File path for local JSON store (default relative to cwd when starting uvicorn).
# JUSTWORK_BACKEND_DATA_FILE=

# Share links (readonly): signed token + optional public base URL.
# JUSTWORK_SHARE_SECRET=
# JUSTWORK_PUBLIC_BASE_URL=http://127.0.0.1:1446

# Quota plan switch (current global toggle; workspace-level Pro can plug in later):
# JUSTWORK_QUOTA_PLAN=free
#
# Free plan defaults:
# JUSTWORK_QUOTA_WORKSPACE_MAX_BYTES_FREE=41943040
# JUSTWORK_QUOTA_PAGE_MAX_COUNT_FREE=300
# JUSTWORK_QUOTA_FOLDER_MAX_COUNT_FREE=100
#
# Pro plan defaults (future reserve):
# JUSTWORK_QUOTA_WORKSPACE_MAX_BYTES_PRO=209715200
# JUSTWORK_QUOTA_PAGE_MAX_COUNT_PRO=1500
# JUSTWORK_QUOTA_FOLDER_MAX_COUNT_PRO=500
